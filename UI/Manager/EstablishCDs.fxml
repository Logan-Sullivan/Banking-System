<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="EstablishCDsController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Establish CDs" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer Name" />
        <ComboBox fx:id="customerComboBox"
                  promptText="Select customer name"
                  prefWidth="280.0" />

        <Label text="CD Term" />
        <ComboBox fx:id="cdTermComboBox" prefWidth="280.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="6 Months" />
                    <String fx:value="12 Months" />
                    <String fx:value="24 Months" />
                    <String fx:value="36 Months" />
                </FXCollections>
            </items>
        </ComboBox>

        <Label text="Initial Deposit" />
        <TextField fx:id="initialDepositField" promptText="Enter initial deposit" prefWidth="280.0" />

        <Label text="Interest Rate" />
        <TextField fx:id="interestRateField" promptText="Enter CD interest rate" prefWidth="280.0" />

        <Label text="Early Withdrawal Penalty" />
        <TextField fx:id="earlyPenaltyField" text="50.0" promptText="Enter penalty amount" prefWidth="280.0" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Establish CD"
                prefWidth="180.0"
                onAction="#establishCDPressed" />
        <Button text="Return to Manager Screen"
                prefWidth="180.0"
                onAction="#returnToManagerScreen" />
    </VBox>

    <Label fx:id="statusLabel"
           text="After processing, return to the Manager Screen."
           style="-fx-font-size: 12px;" />
</VBox>
