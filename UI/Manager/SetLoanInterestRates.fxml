<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="SetLoanInterestRatesController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Set Interest Rates on Loans" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

	    <VBox spacing="10.0" maxWidth="320.0">
	        <Label text="Loan Type" />
	        <ComboBox fx:id="loanTypeCombo" prefWidth="280.0">
	            <items>
	                <FXCollections fx:factory="observableArrayList">
	                    <String fx:value="Mortgage Loan - 15 Year" />
	                    <String fx:value="Mortgage Loan - 30 Year" />
                    <String fx:value="Short Term Loan" />
                    <String fx:value="Credit Card Account" />
                </FXCollections>
            </items>
	        </ComboBox>

	        <Label text="Interest Rate" />
	        <TextField fx:id="rateField" promptText="Enter interest rate" prefWidth="280.0" />

	        <Label text="Effective Date" />
	        <TextField fx:id="effectiveDateField" promptText="Enter effective date" prefWidth="280.0" />
	    </VBox>

	    <VBox spacing="12.0" alignment="CENTER">
	        <Button text="Update Loan Rate" prefWidth="180.0" onAction="#updateLoanRate" />
	        <Button text="Return to Manager Screen"
	                prefWidth="180.0"
	                onAction="#returnToManagerScreen" />
	    </VBox>

	    <Label fx:id="statusLabel" style="-fx-font-size: 12px;" />
	    <Label text="After updating, return to the Manager Screen." style="-fx-font-size: 12px;" />
	</VBox>
