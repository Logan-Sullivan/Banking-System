<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="CreateNewCreditCardController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Create New Credit Card" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <ComboBox fx:id="customerComboBox"
              promptText="Select Customer"
              prefWidth="300.0" />

    <TextField fx:id="creditLimitField"
               promptText="Credit Limit"
               prefWidth="300.0"
               maxWidth="300.0" />

    <TextField fx:id="interestRateField"
               promptText="Interest Rate"
               prefWidth="300.0"
               maxWidth="300.0" />

    <TextField fx:id="startingBalanceField"
               promptText="Starting Balance / Amount Due"
               prefWidth="300.0"
               maxWidth="300.0" />

    <Button text="Create Credit Card"
            onAction="#createCreditCardPressed"
            prefWidth="300.0" />

    <Label fx:id="statusLabel" text="" visible="false" />

    <Button text="Return to Teller Screen"
            onAction="#returnToTellerScreen"
            prefWidth="300.0" />

</VBox>
