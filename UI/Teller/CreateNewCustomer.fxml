<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CreateNewCustomerController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Create New Customer" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer ID" />
        <TextField fx:id="customerIdField" promptText="Enter customer ID" prefWidth="280.0" />

        <Label text="Address" />
        <TextField fx:id="addressField" promptText="Enter address" prefWidth="280.0" />

        <Label text="City" />
        <TextField fx:id="cityField" promptText="Enter city" prefWidth="280.0" />

        <Label text="State" />
        <TextField fx:id="stateField" promptText="Enter state" prefWidth="280.0" />

        <Label text="Zipcode" />
        <TextField fx:id="zipcodeField" promptText="Enter zipcode" prefWidth="280.0" />

        <Label text="First Name" />
        <TextField fx:id="firstNameField" promptText="Enter first name" prefWidth="280.0" />

        <Label text="Last Name" />
        <TextField fx:id="lastNameField" promptText="Enter last name" prefWidth="280.0" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Create Customer"
                prefWidth="180.0" />
        <Button text="Return to Teller Screen"
                prefWidth="180.0"
                onAction="#returnToTellerScreen" />
    </VBox>

    <Label text="After creation, return to the Teller Screen." style="-fx-font-size: 12px;" />
</VBox>
