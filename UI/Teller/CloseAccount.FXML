<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="14.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CloseAccountController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Close Account"
           style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="380.0">
        <Label text="Customer" />
        <ComboBox fx:id="customerComboBox"
                  promptText="Select customer"
                  prefWidth="340.0"
                  onAction="#onCustomerChosen" />

        <Label text="Account or Loan" />
        <ComboBox fx:id="accountComboBox"
                  promptText="Select account or loan"
                  prefWidth="340.0" />
    </VBox>

    <VBox alignment="CENTER" spacing="12.0">
        <Button text="Close Selected Account/Loan"
                prefWidth="260.0"
                onAction="#closeSelectedPressed" />

        <Button text="Close Entire Customer"
                prefWidth="260.0"
                onAction="#closeEntireCustomerPressed" />

        <Button text="Return to Teller Screen"
                prefWidth="260.0"
                onAction="#returnToTellerScreen" />
    </VBox>

    <TextArea fx:id="resultArea"
              prefWidth="520.0"
              prefHeight="160.0"
              editable="false"
              wrapText="true" />

    <Label fx:id="statusLabel"
           text="Select a customer to begin."
           style="-fx-font-size: 12px;" />

</VBox>
