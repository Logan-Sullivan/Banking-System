<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="LinkAccountsController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Link Accounts" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer ID" />
        <ComboBox fx:id="customerIdComboBox"
                  onAction="#onCustomerChosen"
                  promptText="Select customer ID"
                  prefWidth="280.0" />

        <Label text="Primary Account" />
        <ComboBox fx:id="primaryAccountComboBox"
                  promptText="Select primary account"
                  prefWidth="280.0" />

        <Label text="Linked Account" />
        <ComboBox fx:id="linkedAccountComboBox"
                  promptText="Select linked account"
                  prefWidth="280.0" />

        <Label text="Link Type" />
        <ComboBox fx:id="linkTypeComboBox"
                  prefWidth="280.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Overdraft Backup" />
                    <String fx:value="Transfer Pair" />
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Link Accounts"
                prefWidth="180.0"
                onAction="#linkAccounts" />
        <Button text="Return to Teller Screen"
                prefWidth="180.0"
                onAction="#returnToTellerScreen" />
    </VBox>

    <Label fx:id="statusLabel"
           text="After linking, return to the Teller Screen."
           style="-fx-font-size: 12px;" />
</VBox>
