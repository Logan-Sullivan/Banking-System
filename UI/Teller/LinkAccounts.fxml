<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Link Accounts" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer ID" />
        <TextField promptText="Enter customer ID" prefWidth="280.0" />

        <Label text="Primary Account Number" />
        <TextField promptText="Enter primary account number" prefWidth="280.0" />

        <Label text="Linked Account Number" />
        <TextField promptText="Enter linked account number" prefWidth="280.0" />

        <Label text="Link Type" />
        <ComboBox prefWidth="280.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Overdraft Backup" />
                    <String fx:value="Transfer Pair" />
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Link Accounts" prefWidth="180.0" />
        <Button text="Return to Teller Screen" prefWidth="180.0" />
    </VBox>

    <Label text="After linking, return to the Teller Screen." style="-fx-font-size: 12px;" />
</VBox>