<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="14.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ReviewCustomerAccountsController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Review Customer Accounts"
           style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox maxWidth="380.0" spacing="10.0">
        <Label text="Customer Name" />
        <ComboBox fx:id="customerIdComboBox"
                  promptText="Select customer name"
                  prefWidth="340.0" />
    </VBox>

    <Label text="ATM Card Status" style="-fx-font-weight: bold;" />
    <TextArea fx:id="atmArea"
              prefWidth="340.0"
              prefHeight="55.0"
              editable="false" />

    <HBox spacing="15.0" alignment="CENTER">
        <VBox spacing="8.0">
            <Label text="Savings Accounts" style="-fx-font-weight: bold;" />
            <TextArea fx:id="savingsArea" prefWidth="330.0" prefHeight="150.0" editable="false" />

            <Label text="TMB Checking Accounts" style="-fx-font-weight: bold;" />
            <TextArea fx:id="tmbArea" prefWidth="330.0" prefHeight="150.0" editable="false" />
        </VBox>

        <VBox spacing="8.0">
            <Label text="Gold/Diamond Accounts" style="-fx-font-weight: bold;" />
            <TextArea fx:id="gdArea" prefWidth="330.0" prefHeight="150.0" editable="false" />

            <Label text="CD Accounts" style="-fx-font-weight: bold;" />
            <TextArea fx:id="cdArea" prefWidth="330.0" prefHeight="150.0" editable="false" />
        </VBox>

        <VBox spacing="8.0">
            <Label text="Credit Cards" style="-fx-font-weight: bold;" />
            <TextArea fx:id="creditCardArea" prefWidth="330.0" prefHeight="150.0" editable="false" />

            <Label text="Loan Accounts" style="-fx-font-weight: bold;" />
            <TextArea fx:id="loanArea" prefWidth="330.0" prefHeight="150.0" editable="false" />
        </VBox>
    </HBox>

    <VBox alignment="CENTER" spacing="12.0">
        <Button prefWidth="220.0"
                text="Search Accounts"
                onAction="#searchAccounts" />

        <Button prefWidth="220.0"
                text="Return to Teller Screen"
                onAction="#returnToTellerScreen" />
    </VBox>

    <Label fx:id="statusLabel"
           style="-fx-font-size: 12px;"
           text="Select a customer to view account status." />

</VBox>
