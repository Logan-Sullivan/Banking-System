<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ReviewCustomerAccountsController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Review Customer Accounts" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="420.0">
        <Label text="Customer ID" />
        <TextField promptText="Enter customer ID" prefWidth="360.0" />

        <HBox spacing="12.0" alignment="CENTER">
            <Button text="Search Accounts" prefWidth="160.0" />
            <Button text="Return to Teller Screen"
                    prefWidth="180.0"
                    onAction="#returnToTellerScreen" />
        </HBox>
    </VBox>

    <VBox spacing="10.0" alignment="CENTER">
        <Label text="Customer Account Summary" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView prefWidth="700.0" prefHeight="260.0">
            <columns>
                <TableColumn text="Account Number" prefWidth="140.0" />
                <TableColumn text="Type" prefWidth="120.0" />
                <TableColumn text="Balance" prefWidth="120.0" />
                <TableColumn text="Recent Debit" prefWidth="140.0" />
                <TableColumn text="Status" prefWidth="120.0" />
                <TableColumn text="Notes" prefWidth="60.0" />
            </columns>
        </TableView>
    </VBox>

    <Label text="After review, return to the Teller Screen." style="-fx-font-size: 12px;" />
</VBox>