<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ReviewAccountStatusController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 26px; -fx-font-weight: bold;" text="Review Account Status" />

    <VBox maxWidth="600.0" spacing="10.0">
        <Label text="Customer Account Overview" />

        <TableView prefHeight="300.0" prefWidth="550.0">
            <columns>
                <TableColumn prefWidth="150.0" text="Account Number" />
                <TableColumn prefWidth="120.0" text="Type" />
                <TableColumn prefWidth="120.0" text="Balance" />
                <TableColumn prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
    </VBox>

    <VBox alignment="CENTER" spacing="12.0">
        <Button prefWidth="180.0" text="Refresh Accounts" />
        <Button prefWidth="180.0"
                text="Return to Customer Screen"
                onAction="#returnToCustomerScreen" />
    </VBox>

    <Label style="-fx-font-size: 12px;" text="View all accounts" />
</VBox>
