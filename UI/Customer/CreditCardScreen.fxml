<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="CreditCardScreenController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Credit Card Screen" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer ID" />
        <TextField promptText="Enter customer ID" prefWidth="280.0" />

        <Label text="Credit Card Account Number" />
        <TextField promptText="Enter credit card account number" prefWidth="280.0" />

        <Label text="Current Balance" />
        <TextField promptText="Display current balance" prefWidth="280.0" editable="false" />

        <Label text="Payment Amount" />
        <TextField promptText="Enter payment amount" prefWidth="280.0" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Make Payment" prefWidth="180.0" />
        <Button text="Return to Customer Screen" prefWidth="180.0" onAction="#returnToCustomerScreen" />
    </VBox>

    <Label text="After payment, return to the Customer Screen." style="-fx-font-size: 12px;" />
</VBox>