<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ATMWithdrawController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="ATM Withdraw" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer Name" />
        <ComboBox fx:id="customerIdComboBox"
                  onAction="#onCustomerChosen"
                  promptText="Select customer name"
                  prefWidth="280.0" />

        <Label text="Withdrawal Amount" />
        <TextField fx:id="withdrawAmountField"
                   promptText="Enter withdrawal amount"
                   prefWidth="280.0" />
    </VBox>
    <Label text="Withdrawal Output" style="-fx-font-weight: bold;" />

    <Label fx:id="withdrawsLabel" text="Withdraws Remaining: " style="-fx-font-size: 12px;" />
    <Label fx:id="previousBalanceLabel" text="Previous Balance: $" style="-fx-font-size: 12px;" />
    <Label fx:id="withdrawalAmountLabel" text="Withdrawal Amount: $" style="-fx-font-size: 12px;" />
    <Label fx:id="newBalanceLabel" text="New Balance: $" style="-fx-font-size: 12px;" />

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Withdraw"
                prefWidth="180.0"
                onAction="#withdrawPressed" />
        <Button text="Return to Customer Screen"
                prefWidth="180.0"
                onAction="#returnToCustomerScreen" />
    </VBox>

    <Label fx:id="statusLabel" text="Ready." style="-fx-font-size: 12px;" />
</VBox>