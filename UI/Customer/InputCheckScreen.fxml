<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="InputCheckScreenController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Input Check Screen" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="320.0">
        <Label text="Customer ID" />
        <TextField promptText="Enter customer ID" prefWidth="280.0" />

        <Label text="Checking Account Number" />
        <TextField promptText="Enter checking account number" prefWidth="280.0" />

        <Label text="Check Number" />
        <TextField promptText="Enter check number" prefWidth="280.0" />

        <Label text="Check Amount" />
        <TextField promptText="Enter check amount" prefWidth="280.0" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Submit Check" prefWidth="180.0" />
        <Button text="Return to Customer Screen"
                prefWidth="180.0"
                onAction="#returnToCustomerScreen" />
    </VBox>

    <Label text="After submitting, return to the Customer Screen." style="-fx-font-size: 12px;" />
</VBox>