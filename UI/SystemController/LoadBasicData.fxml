<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="LoadBasicDataController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Load Basic Data" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="360.0">
        <Label text="Data Source File" />
        <TextField fx:id="dataSourceField"
                   text="src/data.csv"
                   promptText="Enter data file path"
                   prefWidth="300.0" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Load Data" prefWidth="180.0" onAction="#loadData" />
        <Button text="Validate Data" prefWidth="180.0" onAction="#validateData" />
        <Button text="Return to System Controller"
                prefWidth="180.0"
                onAction="#returnToSystemController" />
    </VBox>

    <Label fx:id="statusLabel" text="Ready." style="-fx-font-size: 12px;" />
    <Label text="Load core banking data before running the system." style="-fx-font-size: 12px;" />
</VBox>
