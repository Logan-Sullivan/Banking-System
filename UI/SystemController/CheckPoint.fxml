<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Check Point System" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="360.0">
        <Label text="Select system state items to save before shutdown:" />

        <CheckBox text="Save Databases for Recovery" selected="true" />
        <CheckBox text="Save Screen Status for Recovery" selected="true" />
        <CheckBox text="Save Current User Session State" selected="true" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Begin Check Point" prefWidth="180.0" />
        <Button text="Shut Down System" prefWidth="180.0" />
        <Button text="Restore Saved State" prefWidth="180.0" />
        <Button text="Return to System Controller" prefWidth="180.0" />
    </VBox>

    <Label text="Checkpoint saves data and screen state before system shutdown." style="-fx-font-size: 12px;" />
</VBox>