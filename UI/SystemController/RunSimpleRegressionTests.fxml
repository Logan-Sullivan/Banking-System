<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RunSimpleRegressionTestsController"
      alignment="CENTER">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Run Simple Regression Tests" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="10.0" maxWidth="360.0">
        <Label text="Select tests to run:" />

        <CheckBox text="Load Customer Data Test" selected="true" />
        <CheckBox text="Create Account Test" selected="true" />
        <CheckBox text="Transfer / Overdraft Test" selected="true" />
        <CheckBox text="Stop Payment Test" selected="true" />
    </VBox>

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="Run Selected Tests" prefWidth="180.0" />
        <Button text="View Test Results" prefWidth="180.0" />
        <Button text="Return to System Controller"
                prefWidth="180.0"
                onAction="#returnToSystemController" />
    </VBox>

    <Label text="Run a small test set before full system use." style="-fx-font-size: 12px;" />
</VBox>