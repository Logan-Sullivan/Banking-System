<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="RunSimpleRegressionTestsController"
      alignment="CENTER">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Run Simple Regression Tests"
           style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="12.0" alignment="CENTER">
        <Button text="MainTests"
                prefWidth="260.0"
                onAction="#runMainTests" />

        <Button text="AccountTests"
                prefWidth="260.0"
                onAction="#runAccountTests" />

        <Button text="LoanTests"
                prefWidth="260.0"
                onAction="#runLoanTests" />

        <Button text="TimelineIntegrationTests"
                prefWidth="260.0"
                onAction="#runTimelineIntegrationTests" />

        <Button text="Return to System Controller"
                prefWidth="260.0"
                onAction="#returnToSystemController" />
    </VBox>

    <Label text="Test Results" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <TextArea fx:id="resultsArea"
              prefWidth="650.0"
              prefHeight="260.0"
              editable="false"
              wrapText="true" />

</VBox>
