<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ProgressTimeController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Progress System Time" style="-fx-font-size: 26px; -fx-font-weight: bold;" />

    <VBox spacing="12.0" maxWidth="300.0" alignment="CENTER">
        <Label fx:id="currentDateLabel" text="Current Date:" style="-fx-font-size: 14px;" />

        <TextField fx:id="daysField"
                   promptText="Enter number of days"
                   prefWidth="260.0" />

        <Button text="Progress Time"
                onAction="#progressTime"
                prefWidth="260.0" />

        <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;" />

        <Button text="Return to System Controller"
                onAction="#returnToSystemController"
                prefWidth="260.0" />
    </VBox>

</VBox>
